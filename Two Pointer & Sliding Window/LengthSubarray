Find length of Longest Subarray wth given condition


Solution:

public class Main {
    public static void main(String[] args) {
      int arr[]={1,2,3,4,5,6};
      int k=12;
      System.out.println(LengthSubarray(arr,k));
    }
    public static int LengthSubarray(int arr[], int k){
      int n=arr.length-1;
      int left_pointer=0;
      int right_pointer=0;
      int sum=0;
      int maxLen=0;

      while(right_pointer<n){
        sum=sum+arr[right_pointer];
        if(sum <=k){
          maxLen=Math.max(maxLen,right_pointer-left_pointer+1);
        }
        right_pointer++;
      }
      return maxLen;
    }
}
