Better Approach: Using prefix sum

Soltution:
public class Main{
    public static void main(String args[]){
        int arr[]={1,2,3};int m=3;
        System.out.println(LongestSubarrayCount(arr, m));
    }
    public static int LongestSubarrayCount(int []nums,int k){
      int n=nums.length;
      int prefixSum=0;
      int subArray_Count=0;
      HashMap<Integer,Integer> store=new HashMap<>();

      for(int i=0;i<n;i++){
        prefixSum+=nums[i];
        if(!store.containsKey(prefixSum)){
          store.put(prefixSum,i);
        }

        //Valid Condition
        if(prefixSum==k){
          subArray_Count++;
        }
        //Invalid Condition
        int rem=prefixSum-k;
        if(store.containsKey(rem)){
          subArray_Count++;
        }
      }
       return subArray_Count;
    }
}
