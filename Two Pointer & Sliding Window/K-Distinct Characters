Longest Substring With At Most K Distinct Characters

Given a string s and an integer k.Find the length of the longest substring with at most k distinct characters.


Example 1
Input : s = "aababbcaacc" , k = 2
Output : 6
Explanation : The longest substring with at most two distinct characters is "aababb".
The length of the string 6.

Example 2
Input : s = "abcddefg" , k = 3
Output : 4
Explanation : The longest substring with at most three distinct characters is "bcdd".
The length of the string 4.

Brute Force Approach: 
*Find all the subarray
*Add elements to Hashset and check for the size it should contain exactly k distinct elements
*If it contains exactly k distinct elements and then return the len of substring.

Solution:
public class Main{
    public static void main(String args[]){
        String s="abcddefg";
        int n=3;
        System.out.println(LongestSubstring(s,n));
    }
    public static int LongestSubstring(String s, int k){
      int n=s.length();
      HashSet<String> ans=new HashSet<>();
      int maxLen=0;

      for(int i=0;i<n;i++){
           ans.clear();
        for(int j=i;j<n;j++){
           char chk=s.charAt(j);

           if(!ans.contains(String.valueOf(chk))){
            ans.add(String.valueOf(chk));
            System.out.println(ans);
           }

           if(ans.size()<=k){
            maxLen=Math.max(maxLen,j-i+1);
            System.out.println(maxLen);
           }else{
            break;
           }
        }
      }
      
      return maxLen;
    }
}

Better Solution Approach: Use two pointers
* Move from left to right and store substring
* Keep character frequency on HashMap and maintain the size of HashMap with k
* If size exceeds than k the remove elements fron left_pointer
* If size is exactly k then store the substring length 


Solution:
import java.util.*;

public class Main{
    public static void main(String args[]){
        String s="abcccvvdd";
        int n=3;
        System.out.println(LongestSubstring(s,n));
    }
    public static int LongestSubstring(String s, int k){
      int n=s.length();
      int maxLen=0;
      int left_pointer=0;
      int right_pointer=0;
      HashMap<Character, Integer> ans=new HashMap<>();
      int freq=0;

      while(right_pointer<n){
        char chk=s.charAt(right_pointer);

        if(ans.containsKey(chk)){
          freq=ans.get(chk);
          ans.put(chk,freq++);
        }else{
          ans.put(chk,1);
        }
         
        if(ans.size() > k){
          while(ans.size() > k){
            char chk_left=s.charAt(left_pointer);
            freq=ans.get(chk_left);
            ans.put(chk_left,freq-1);
            if(ans.get(chk_left)== 0){
              ans.remove(chk_left);
            }
            left_pointer++;
          }
        }

        if(ans.size()<=k){
          maxLen=Math.max(maxLen,right_pointer-left_pointer+1);
        }
       right_pointer++;
      } 
      return maxLen;
    }
}
                     
