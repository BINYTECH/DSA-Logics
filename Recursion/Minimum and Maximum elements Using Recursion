   public static int[] Max_Min_Value(int arr[]){
     int max=arr[0];
     int min=arr[0];
     int Max_Min_Value[]=new int[2];

     for(int i=0;i<arr.length;i++){
      if(arr[i]<min){
        min=arr[i];
      }
      if(arr[i]>max){
        max=arr[i];
      }
     }
     Max_Min_Value[0]=min;
     Max_Min_Value[1]=max;
     return Max_Min_Value;
   }
}
